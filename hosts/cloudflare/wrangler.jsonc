{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "board",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // a2's log store imports node:sqlite; it runs on the object's SQLite through our stand-in.
  "alias": { "node:sqlite": "../../packages/sql/src/node-sqlite.ts" },
  "durable_objects": { "bindings": [{ "name": "BOARD", "class_name": "BoardObject" }] },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "board-files" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardObject"] }],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BOARD_OWNER_ID": "token:user:pruett",
    "BOARD_OWNER_HANDLE": "pruett",
    "BOARD_PUBLIC_URL": "https://board.pruett.workers.dev/api/board"
  }
}
