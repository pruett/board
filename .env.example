# Copy to .env (gitignored) and fill in; `bun run vb` (scripts/vb.ts) reads it. Variables already set in the
# environment win, so a cloud VM can inject them instead of having this file.
BOARD_TOKEN=
# Defaults to the deployed board. For a local `bun run dev` board:
# BOARD_URL=http://localhost:8788/api/board
